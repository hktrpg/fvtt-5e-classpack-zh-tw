{
  "_id": "UcTb44qcFcpYkA0I",
  "name": "生死流轉 Strength Before Death",
  "type": "feat",
  "img": "modules/dnd5e_classpack-zh-tw/Nicons/000411.png",
  "system": {
    "type": {
      "value": "class",
