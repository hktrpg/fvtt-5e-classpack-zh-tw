  "name": "絕對統御 Unbreakable Majesty",
  "type": "feat",
  "img": "modules/dnd5e_classpack-zh-tw/Nicons/httpcloud3steamusercontentcomugc84258513611610574219070A1F97FB9AB9097E2A1CE5DF05A9FDC769ED.jpg",
  "system": {
