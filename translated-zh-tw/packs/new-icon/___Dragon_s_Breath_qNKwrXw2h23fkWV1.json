    "dae": {
      "macro": {
        "name": "龍息術Dragon's Breath",
        "img": "modules/dnd5e_classpack-zh-tw/Nicons/spell_deathknight_breathofsindragosa.png",
        "type": "script",
        "scope": "global",
        "command": "(async () => {\n  const caster = actor;\n  const target = canvas.tokens.controlled[0]?.actor;\n  if (!caster || !target) return ui.notifications.warn(\"請選擇施法者和目標\");\n\n  const saveDC = caster.system.attributes.spell.dc;\n  if (!saveDC) return ui.notifications.warn(\"未找到施法者的豁免 DC\");\n\n  const damageType = await new Promise(r => new Dialog({\n    title: \"選擇傷害類型\",\n    content:`<form><label>類型：<select id=\"dt\">\n      <option value=\"fire\">火焰</option><option value=\"cold\">寒冷</option>\n      <option value=\"lightning\">閃電</option><option value=\"poison\">毒素</option>\n      <option value=\"acid\">酸性</option></select></label></form>`,\n    buttons:{ ok:{label:\"確定\",callback:h=>r(h.find(\"#dt\").val())}, cancel:{label:\"取消\",callback:()=>r(null)} },\n    default:\"ok\"\n  }).render(true));\n  if (!damageType) return ui.notifications.warn(\"未選擇傷害類型\");\n\n  const spellLevel = await new Promise(r => new Dialog({\n    title: \"選擇法術位環級\",\n    content:`<form><label>環級（最少 2）：<input id=\"lvl\" type=\"number\" min=\"2\" value=\"2\"></label></form>`,\n    buttons:{ ok:{label:\"確定\",callback:h=>r(parseInt(h.find(\"#lvl\").val())||3)}, cancel:{label:\"取消\",callback:()=>r(null)} },\n    default:\"ok\"\n  }).render(true));\n  if (!spellLevel) return ui.notifications.warn(\"未選擇環級\");\n\n  const extraDice = Math.max(0, spellLevel - 2);\n\n  const item = target.items.find(i => i.name === \"龍息\");\n  if (!item) return ui.notifications.warn(\"目標無“龍息”物品\");\n\n  const formula = `3d6[${damageType}]${extraDice>0? `+${extraDice}d6`: \"\"}`;\n\n  await item.update({\n    [`system.activities.nt6z0FF53gKwBdeL.damage.parts`]: [{\n      custom: { enabled: false, formula: \"\" },\n      number: 3 + extraDice,\n      denomination: 6,\n      bonus: \"\",\n      types: [damageType],\n      scaling: { number: 1 }\n    }],\n    [`system.activities.nt6z0FF53gKwBdeL.save.dc.formula`]: saveDC.toString()\n  });\n\n  ui.notifications.info(`更新成功：類型 ${damageType}，傷害 ${formula}，豁免 DC ${saveDC}`);\n})();",
        "author": "WqWGW8MuBm7BNHxt",
