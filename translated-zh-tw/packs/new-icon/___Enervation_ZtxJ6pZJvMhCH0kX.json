    "dae": {
      "macro": {
        "name": "汲能術Enervation",
        "img": "modules/dnd5e_classpack-zh-tw/Nicons/spell_priest_voidsear.png",
        "type": "script",
        "scope": "global",
        "command": "const workflow = args[0]?.workflow;\nif (!workflow) return console.log(\"宏觸發但 workflow 不存在\");\nconsole.log(\"【調試】damageDetail:\", workflow.damageDetail);\n\nlet necroticTotal = 0;\n// 遍歷 damageDetail（數組，每項包含 damageType & damage）\nif (Array.isArray(workflow.damageDetail)) {\n  workflow.damageDetail.forEach(entry => {\n    if (entry.type === \"necrotic\") necroticTotal += (entry.damage || 0);\n  });\n}\n\nif (necroticTotal === 0) {\n  return console.log(\"未造成黯蝕傷害，跳過治療\");\n}\n\nconst healAmount = Math.floor(necroticTotal / 2);\nconsole.log(`黯蝕傷害總計 ${necroticTotal} → 回覆 ${healAmount}`);\n\nlet casterToken = null;\nif (workflow.tokenUuid) {\n  const doc = await fromUuid(workflow.tokenUuid);\n  casterToken = doc?.object ?? null;\n} else if (workflow.tokenId) {\n  casterToken = canvas.tokens.get(workflow.tokenId);\n} else {\n  casterToken = canvas.tokens.controlled[0];\n}\nif (!casterToken) return console.log(\"無法找到施法者 token\");\n\nawait MidiQOL.applyTokenDamage(\n  [{ type: \"healing\", damage: healAmount }],\n  healAmount,\n  new Set([casterToken]),\n  workflow,\n  null\n);\n\nChatMessage.create({\n  content: `${casterToken.name} 從黯蝕傷害 ${necroticTotal} 中回覆了 ${healAmount} 點生命（只針對黯蝕傷害）`\n});\n\nconsole.log(\"治療已應用，僅針對黯蝕傷害\");",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
