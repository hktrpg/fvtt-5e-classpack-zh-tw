    {
      "type": "enchantment",
      "name": "龍觸法器(神化) Dragon-Touched Focus",
      "img": "modules/dnd5e_classpack-zh-tw/Nicons/inv_ring_ardenweald_02_green.jpg",
      "disabled": true,
      "_id": "RQIY3r72v2sX0d7q",
