    {
      "_id": "tw4kgzjyC5HgEofi",
      "name": "盾牌 Shield",
      "type": "equipment",
      "system": {
        "description": {
          "value": "<div class=\"rd__b  rd__b--2\"><div class=\"WordSection1\"><div><p class=\"MsoNormal\" style=\"LAYOUT-GRID-MODE:char;MARGIN:2pt 0cm\"><span style=\"FONT-SIZE:10.5pt;mso-ascii-font-family:Cambria;mso-hansi-font-family:Cambria;mso-bidi-font-size:14.0pt\">盾牌通常由木材或金屬製成，可以單手進行持用。持用一面盾牌可以令你的護甲等級加</span>2<span style=\"FONT-SIZE:10.5pt;mso-ascii-font-family:Cambria;mso-hansi-font-family:Cambria;mso-bidi-font-size:14.0pt\">。不過同一時間裏你只能從一面盾牌中受益。</span><span lang=\"EN-US\" style=\"FONT-SIZE:10.5pt;mso-fareast-font-family:'STHeiti light'\"><br /></span>A shield is made from wood or metal and is carried in one hand. Wielding a shield increases your Armor Class by 2. You can benefit from only one shield at a time.</p></div></div></div>",
          "chat": ""
        },
        "source": {
          "custom": "",
          "book": "PHB'14",
          "page": "144",
          "license": "",
          "rules": "2014",
          "revision": 1
        },
        "quantity": 1,
        "weight": {
          "value": 6,
          "units": "lb"
        },
        "price": {
          "value": 10,
          "denomination": "gp"
        },
